# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/finance_helper

# Server
PORT=5000

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — your Vercel client URL (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Superadmin — used by: npm run create-superadmin
SUPERADMIN_EMAIL=superadmin@company.local
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_NAME=Super Admin
